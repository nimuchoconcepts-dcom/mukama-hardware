  <!-- ──── JAVASCRIPT ──── -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
  </script>
  <script>
    // ── Data ──

    const categories = [
      { name: 'Cement & Building', img: 'images/cement.JPG' },
      { name: 'Steel & Metal', img: 'images/steel.JPG' },
      { name: 'Roofing Materials', img: 'images/roofing.JPG' },
      { name: 'Paints & Finishes', img: 'images/paints.JPG' },
      { name: 'Plumbing Supplies', img: 'images/plumbing.JPG' },
      { name: 'Electrical Supplies', img: 'images/electrical.JPG' },
      { name: 'Tiles & Sanitary', img: 'images/tiles.JPG' },
      { name: 'Hand Tools', img: 'images/handtools.JPG' },
    ];

    const featuredProducts = [
      { name: 'ironbars', price:'UGX 20,000' , img: 'images/ironbars.JPG' },
      { name: 'Gauge 12 gabions', price: 'UGX 150,000', img: 'images/gabionss.JPG' },
      { name: 'Green Coated Gabions pvc coated', price: 'UGX 270,000', img: 'images/gabionsss.JPG' },
      { name: 'Steel Rebar', price: 'UGX 20,000', img: 'images/steelrebar2.JPG' },
      { name: 'Iron Sheets', price: 'UGX 23,000', img: 'images/ironsheets.JPG' },
      { name: 'Pipes ', price: 'UGX 14,000', img: 'images/pipes.JPG' },
      { name: 'Guage 10 Gabions', price: 'UGX 180,000', img: 'images/gabions.JPG' },
      { name: 'Original Gabion macferri ', price: 'UGX 250,000', img: 'images/gabi.JPG' },
    ];

    const materialsList = [
      { name: 'Angle Lines', img: 'images/anglelines.JPG' },
      { name: 'Chain Links', img: 'images/chainlinks.JPG' },
      { name: 'Hollow Sections', img: 'images/hollowsections.JPG' },
      { name: 'Iron Bars', img: 'images/ironbars.JPG' },
      { name: 'Mild Steel Plates', img: 'images/middlesteelplates.JPG' },
      { name: 'Gabion Boxes', img: 'images/gabionsboxes.JPG' },
      { name: 'Gabion Cages', img: 'images/gabioncages.JPG' },
      { name: 'Barbed Wires', img: 'images/barbedwire.JPG' },
      { name: 'Expanded Metals', img: 'images/expandedmetals.JPG' },
    ];

    const reviews = [
      { name: 'James Okello', role: 'Contractor', text: 'MUKAMA MWESIGWA Hardware has been my go-to supplier for over five years. Their cement and steel quality is unmatched, and delivery is always on time.', stars: 5, img: 'https://i.pravatar.cc/100?img=' },
      { name: 'Sarah Nambi', role: 'Home Builder', text: 'I built my dream home with materials from this hardware. The team guided me on the best roofing and paint options. Professional service.', stars: 5, img: 'https://i.pravatar.cc/100?img=' },
      { name: 'David Muwonge', role: 'Real Estate Developer', text: 'We use MUKAMA MWESIGWA for all our bulk supplies. Competitive pricing, consistent stock, and excellent customer support.', stars: 5, img: 'https://i.pravatar.cc/100?img=' },
    ];

    // ── Render ──

    function renderCategories() {
      const grid = document.getElementById('categoriesGrid');
      grid.innerHTML = categories.map(c => `
        <div class="col-6 col-sm-4 col-lg-3">
          <div class="category-card">
            <img src="${c.img}" alt="${c.name}" loading="lazy" />
            <div class="cat-name">${c.name}</div>
          </div>
        </div>
      `).join('');
    }

    function renderFeaturedProducts() {
      const grid = document.getElementById('productsGrid');
      grid.innerHTML = featuredProducts.map(p => `
        <div class="col-sm-6 col-lg-4 col-xl-3">
          <div class="product-card">
            <img src="${p.img}" alt="${p.name}" loading="lazy" />
            <div class="card-body">
              <h5 class="fw-bold fs-6" style="font-size:clamp(0.9rem, 1vw, 1rem);">${p.name}</h5>
              <p class="product-price">${p.price}</p>
              <a href="https://wa.me/256744530199?text=Hello%20MUKAMA%20MWESIGWA%20Hardware,%20I%20am%20interested%20in%20${encodeURIComponent(p.name)}" target="_blank" class="btn-primary-custom w-100 justify-content-center py-2" style="font-size:clamp(0.8rem, 0.9vw, 0.9rem);">Add to Enquiry</a>
            </div>
          </div>
        </div>
      `).join('');
    }

    function renderMaterials() {
      const grid = document.getElementById('materialsGrid');
      grid.innerHTML = materialsList.map(m => `
        <div class="col-6 col-sm-4 col-lg-3">
          <div class="product-card">
            <img src="${m.img}" alt="${m.name}" loading="lazy" />
            <div class="card-body text-center">
              <h5 class="fw-bold fs-6" style="font-size:clamp(0.85rem, 0.95vw, 0.95rem);">${m.name}</h5>
            </div>
          </div>
        </div>
      `).join('');
    }

    function renderReviews() {
      const grid = document.getElementById('reviewsGrid');
      grid.innerHTML = reviews.map(r => `
        <div class="col-md-4">
          <div class="card-custom">
            <div class="d-flex align-items-center gap-3 mb-3">
              <img src="${r.img}" alt="${r.name}" class="rounded-circle" width="50" height="50" style="object-fit:cover;" />
              <div>
                <h5 class="fw-bold mb-0" style="font-size:clamp(0.95rem, 1vw, 1.05rem);">${r.name}</h5>
                <p class="small text-muted mb-0">${r.role}</p>
              </div>
            </div>
            <div class="stars text-warning mb-2">${'★'.repeat(r.stars)}${'☆'.repeat(5-r.stars)}</div>
            <p class="card-text" style="font-size:clamp(0.85rem, 0.95vw, 0.95rem);">“${r.text}”</p>
          </div>
        </div>
      `).join('');
    }

    renderCategories();
    renderFeaturedProducts();
    renderMaterials();
    renderReviews();

    // ── Mobile Menu ──
    const menuToggle = document.getElementById('menuToggle');
    const menuClose = document.getElementById('menuClose');
    const mobileMenu = document.getElementById('mobileMenu');
    const overlay = document.getElementById('mobileOverlay');

    function openMenu() {
      mobileMenu.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      mobileMenu.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    menuToggle.addEventListener('click', openMenu);
    menuClose.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
    mobileMenu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

    // ── Sticky Header ──
    const header = document.getElementById('header');
    window.addEventListener('scroll', function() {
      header.classList.toggle('header-scrolled', window.scrollY > 40);
    });

    // ── Intersection Observer for animations ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.fade-up, .stagger-children').forEach(el => observer.observe(el));

    // ── Contact Form ──
    document.getElementById('contactForm').addEventListener('submit', function(e) {
      e.preventDefault();
      alert(' Thank you! Your message has been sent. We will get back to you shortly.');
      this.reset();
    });

    // ── Dynamic Year ──
    document.getElementById('currentYear').textContent = new Date().getFullYear();
  </script>

</body>
